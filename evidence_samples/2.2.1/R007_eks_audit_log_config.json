{
  "document_title": "EKS 제어플레인 감사 로그 설정",
  "document_id": "VARA-INF-AUD-2025-007",
  "collection_date": "2025-04-20",
  "collected_by": "김태현 (시스템관리자)",
  "organization": "(주)바라테크",
  "cluster_name": "vara-prod-eks-cluster",
  "region": "ap-northeast-2",
  "audit_log_enabled": true,
  "eks_logging_config": {
    "clusterLogging": [
      {
        "types": ["api", "audit", "authenticator", "controllerManager", "scheduler"],
        "enabled": true
      }
    ]
  },
  "required_eks_audit_log_types_present": true,
  "cloudtrail_integration": {
    "enabled": true,
    "trail_name": "vara-eks-management-trail",
    "s3_bucket": "vara-cloudtrail-logs-ap-northeast-2",
    "kms_encrypted": true
  },
  "log_retention_days": 730,
  "log_destination": {
    "cloudwatch_log_group": "/aws/eks/vara-prod-eks-cluster/cluster",
    "s3_archive": "s3://vara-audit-archive/eks-logs/",
    "retention_policy": "CloudWatch 90일 보존 후 S3로 이관, S3에서 2년간 보존"
  },
  "dashboard_configured": true,
  "monitoring_dashboard": {
    "tool": "Grafana",
    "url": "https://grafana.vara-internal.co.kr/d/eks-audit/eks-audit-dashboard",
    "alert_rules": [
      "주요 직무자 비인가 접근 시도 탐지",
      "cluster-admin 권한 사용 알림",
      "비업무 시간대 API 호출 알림",
      "대량 데이터 조회 알림"
    ],
    "alert_channels": ["Slack #security-alerts", "이메일 security@vara.co.kr"]
  },
  "kube_apiserver_audit_policy": {
    "level": "RequestResponse",
    "resources": ["pods", "secrets", "configmaps", "serviceaccounts", "clusterroles", "clusterrolebindings"],
    "namespaces": ["production", "payment-service", "customer-data"]
  }
}