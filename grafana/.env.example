# 복사: cp .env.example .env  후 값 채우기 (이 파일은 커밋 X 권장)
#
# ⚠ 이 EC2의 backend는 RDS가 아니라 docker compose 안의 "postgres" 컨테이너를 쓴다.
#    그래서 RDS_HOST=postgres, SSLMODE=disable 로 두고, Grafana를 backend 네트워크에 합류시킨다.

# ── DB (backend의 로컬 postgres 컨테이너) ──
RDS_HOST=postgres            # 컨테이너 서비스명 (RDS 엔드포인트 아님)
RDS_PORT=5432
RDS_DB=vara
RDS_USER=vara                # 빨리 띄우려면 backend와 동일 계정. 분리하려면 grafana_ro 생성 후 교체.
RDS_PASSWORD=changeme
RDS_SSLMODE=disable          # 로컬 컨테이너라 disable (RDS면 require)

# ── backend가 만든 docker 네트워크 이름 (docker network ls | grep vara 로 확인) ──
BACKEND_NETWORK=vara-backend_default

# ── Grafana 외부 URL (브라우저/FE 접근 주소) ──
GRAFANA_ROOT_URL=http://<EC2-IP>:3000

# ── Grafana 관리자 (운영자 로그인용) ──
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=StrongPass!234
