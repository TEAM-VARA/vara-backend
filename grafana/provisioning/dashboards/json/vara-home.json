        {
          "datasource": { "type": "postgres", "uid": "vara-rds" },
          "format": "table",
          "rawSql": "SELECT COUNT(*) FILTER (WHERE risk_level='emergency') AS \"emergency\", COUNT(*) FILTER (WHERE risk_level='warning') AS \"warning\", COUNT(*) FILTER (WHERE risk_level IN ('caution','info')) AS \"caution\", COUNT(*) FILTER (WHERE risk_level='safe') AS \"safe\" FROM final_scores WHERE cluster_name='${cluster}' AND snapshot_at=(SELECT MAX(snapshot_at) FROM final_scores WHERE cluster_name='${cluster}')",
          "refId": "A"
        }
      ],
      "title": "Risk 등급 분포",
      "type": "piechart"
