# 줄바꿈 정규화 — 저장소는 LF로 통일 (CRLF 손상 재발 방지)
* text=auto eol=lf

# 소스/설정/문서: 항상 LF
*.go      text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sql     text eol=lf
*.sh      text eol=lf
*.mod     text eol=lf
*.sum     text eol=lf

# 바이너리: 변환 금지
*.xlsx    binary
*.png     binary
*.jpg     binary
*.pdf     binary
*.gz      binary
