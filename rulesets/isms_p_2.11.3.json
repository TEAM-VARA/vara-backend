            "match": "partial"
          }
        ],
        "automation_coverage": {
          "percentage": 30,
          "covered": "eBPF 기반 shell 활동",
          "not_covered": "audit log 기반 비정상 활동(burst 요청, Forbidden 응답 등)"
        },
        "alternative_controls": [
          "SSM Session Manager",
          "Teleport",
          "외부 PAM 도구"
        ],
        "k8s_only_check": true,
        "deferred": false,
        "deferred_reason": "eBPF process event 파이프라인 연동 완료 — 활성화됨"
      },
      "deferred_from": "F-2.11.3-01",
      "manual_check_output": {
        "applies_when": "always",
        "absorbed_from": "F-2.11.3-01",
        "alternative_controls": [
          "SSM Session Manager",
          "Teleport",
          "외부 PAM 도구"
        ],
        "kisa_defect_case_refs": [
          {
            "case_number": null,
            "description": "모니터링 사각지대 - 운영 중 비정상 활동 미감지",
            "match": "partial"
          }
        ],
        "compliance_mappings": [
          {
            "framework": "ISMS-P",
            "item": "2.11.3",
            "match_strength": "indirect"
          }
        ]
      }
    },
    {
      "rule_id": "R-2.11.3-GL01",
      "name": "이상행위 모니터링 체계 구축",
      "judgment_source": "text_extraction",
      "extraction_method": "rag",
      "keywords": [
        "네트워크 및 시스템의 이상행위를 탐지·분석하기 위한 모니터링 체계를 구축한다."
      ],
      "compliance_indicators": [
        {
          "description": "이상행위 탐지·분석을 위한 모니터링 체계를 구축하도록 규정"
        }
      ],
      "source_reference": {
        "framework": "ISMS-P",
        "item": "2.11.3",
        "basis": "안내서 주요 확인사항/인증기준"
      },
      "judgment_logic": {
        "type": "semantic_match",
        "method": "llm_rag_entailment",
        "match_criteria": "sentence_semantic_equivalence",
        "verdict_states": [
          "충족",
          "미충족",
          "확인불가"
        ]
      }
    },
    {
      "rule_id": "R-2.11.3-GL02",
      "name": "이상행위 기준·임계치 및 적시 대응",
      "judgment_source": "text_extraction",
      "extraction_method": "rag",
      "keywords": [
        "침해시도, 개인정보 유출시도, 부정행위 등을 판단하기 위한 기준 및 임계치를 정의하고, 이에 따라 이상행위의 판단·조사 등 후속 조치가 적시에 이루어지도록 한다."
      ],
      "compliance_indicators": [
        {
          "description": "이상행위 판단 기준·임계치를 정의하고 적시 후속 조치가 이루어지도록 규정"
        }
      ],
      "source_reference": {
        "framework": "ISMS-P",
        "item": "2.11.3",
        "basis": "안내서 주요 확인사항/인증기준"
      },
      "judgment_logic": {
        "type": "semantic_match",
        "method": "llm_rag_entailment",
        "match_criteria": "sentence_semantic_equivalence",
        "verdict_states": [
          "충족",
          "미충족",
          "확인불가"
        ]
      }
    },
    {
      "rule_id": "R-2.11.3-GL03",
      "name": "이상행위 발생 시 적시 대응 절차 수립·이행",
      "judgment_source": "text_extraction",
      "extraction_method": "rag",
      "keywords": [
        "이상행위(침해시도·개인정보 유출시도·부정행위 등) 발생 시 분석·에스컬레이션·차단·보고·복구 등 적시에 대응할 수 있는 절차를 수립하고 이행한다."
      ],
      "compliance_indicators": [
        {
          "description": "이상행위 발생 시 적시 대응(분석·에스컬레이션·차단·보고·복구)할 수 있는 대응 절차를 수립·이행하도록 규정"
        }
      ],
      "source_reference": {
        "framework": "ISMS-P",
        "item": "2.11.3",
        "basis": "안내서 주요 확인사항/인증기준 — 이상행위 발생 시 적시 대응 절차"
      },
      "judgment_logic": {
        "type": "semantic_match",
        "method": "llm_rag_entailment",
        "match_criteria": "sentence_semantic_equivalence",
        "verdict_states": [
          "충족",
          "미충족",
          "확인불가"
        ]
      }
    },
    {
      "rule_id": "R-2.11.3-03",
      "name": "eBPF 런타임 텔레메트리 수집 가동 확인",
      "judgment_source": "k8s_api",
      "extraction_method": "api",
      "monitoring_telemetry": {
        "source": "eBPF",
        "streams": [
          "ebpf_process_events",
          "ebpf_dns_queries",
          "ebpf_network_flows"
        ],
        "scope": "production_namespaces",
        "description": "운영 환경에 eBPF 런타임 텔레메트리(프로세스/DNS/네트워크 흐름)가 수집되고 있어 이상행위 탐지가 가능한지 확인. 현 평가는 per-pod 페이로드로 제공되는 process event 스트림 기준이며, DNS/네트워크 흐름 스트림은 어셈블러 연동 후 확장 가능."
      },
      "compliance_indicators": [
        {
          "field": "ebpf_telemetry_collected",
          "op": "==",
          "value": true,
          "description": "운영 namespace에 eBPF 런타임 텔레메트리 수집 중 — 이상행위 탐지 데이터 확보"
        }
      ],
      "judgment_logic": {
        "type": "structured_match",
        "aggregation": "all_compliance_required"
      },
      "source_reference": {
        "framework": "ISMS-P",
        "item": "2.11.3",
        "basis": "이상행위 탐지 모니터링 체계 가동 — eBPF 런타임 텔레메트리 수집 여부"
      },
      "manual_check_output": {
        "applies_when": "fail"
      }
    }
  ],
  "evaluation_strategy": {
    "overall_verdict_logic": "any_fail_is_non_compliant",
    "description": "운영(prod) namespace에서 Pod exec(shell) 미탐지 + eBPF 런타임 텔레메트리 수집 가동(R-2.11.3-03) 시 PASS"
  }
