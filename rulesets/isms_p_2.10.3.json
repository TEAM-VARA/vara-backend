{
  "schema_version": "4.0.0",
  "isms_p_revision": "2023.11",
  "item": {
    "id": "2.10.3",
    "name": "공개서버 보안",
    "category_path": "2. 보호대책 요구사항 > 2.10 시스템 및 서비스 보안관리 > 2.10.3 공개서버 보안",
    "description": "외부 네트워크에 공개되는 서버의 경우 내부 네트워크와 분리하고, 취약점 점검, 접근통제, 이상징후 모니터링 등 강화된 보호대책을 수립·이행하여야 한다."
  },
  "legal_references": [],
  "rules": [
    {
      "rule_id": "R-2.10.3-01",
      "name": "LoadBalancer source range 미설정",
      "judgment_source": "k8s_api",
      "extraction_method": "api",
      "compliance_indicators": [
        {
          "field": "service.spec.loadBalancerSourceRanges",
          "op": "!=",
          "value": null,
          "description": "loadBalancerSourceRanges 설정됨 — 접근 허용 IP 대역 제한"
        },
        {
          "field": "source_range_not_all_open",
          "op": "==",
          "value": true,
          "description": "0.0.0.0/0 전체 허용이 아닌 특정 IP 대역으로 제한됨"
        }
      ],
      "remediation": {
        "source": {
          "framework": "자체 정책 (표준 미대응)",
          "version": null,
          "reference": "LB source ranges 제한",
          "url": null
        },
        "action": "Service에 loadBalancerSourceRanges로 허용 IP 대역을 명시하고 0.0.0.0/0 전체 개방을 제거한다."
      },
      "judgment_logic": {
        "type": "structured_match",
        "aggregation": "all_compliance_required",
        "min_pass_ratio": 1.0
      }
    },
    {
      "rule_id": "R-2.10.3-02",
      "name": "공개 Ingress WAF annotation 부재",
      "judgment_source": "k8s_api",
      "extraction_method": "api",
      "waf_annotations": [
        "alb.ingress.kubernetes.io/wafv2-acl-arn",
        "alb.ingress.kubernetes.io/waf-acl-id",
        "nginx.ingress.kubernetes.io/modsecurity-snippet"
      ],
      "compliance_indicators": [
        {
          "field": "public_ingress_has_waf",
          "op": "==",
          "value": true,
          "description": "공개 Ingress에 WAF(AWS WAFv2 ACL 또는 ModSecurity) annotation 존재"
        }
      ],
      "remediation": {
        "source": {
          "framework": "보안 best-practice",
          "version": null,
          "reference": "AWS WAFv2/ModSecurity 연동",
          "url": null
        },
        "action": "공개 Ingress에 AWS WAFv2(또는 ModSecurity) 연동 annotation을 추가한다."
      },
      "judgment_logic": {
        "type": "structured_match",
        "aggregation": "all_compliance_required",
        "min_pass_ratio": 1.0
      }
    },
    {
      "rule_id": "R-2.10.3-03",
      "name": "NodePort Service 공개 의도 라벨 부재",
      "judgment_source": "k8s_api",
      "extraction_method": "api",
      "compliance_indicators": [
        {
          "field": "nodeport_service.metadata.labels.exposure-intent",
          "op": "in",
          "value": [
            "public",
            "internal-only",
            "debug"
          ],
          "description": "NodePort Service에 공개 의도 라벨(exposure-intent) 존재 — 의도적 노출임을 명시"
        }
      ],
      "remediation": {
        "source": {
          "framework": "자체 정책 (표준 미대응)",
          "version": null,
          "reference": "노출 의도 라벨(exposure-intent)",
          "url": null
        },
        "action": "NodePort Service에 exposure-intent 라벨(public/internal-only/debug)을 부여하고, 불필요한 NodePort는 ClusterIP로 전환한다."
      },
      "judgment_logic": {
        "type": "structured_match",
        "aggregation": "all_compliance_required",
        "min_pass_ratio": 1.0
      },
      "manual_check_output": {
        "applies_when": "always",
        "absorbed_from": "F-2.10.3-03",
        "alternative_controls": [
          "VPC Security Group",
          "Network ACL"
        ],
        "compliance_mappings": [
          {
            "framework": "ISMS-P",
            "item": "2.10.3",
            "match_strength": "indirect"
          }
        ],
        "offcluster_satisfaction_conditions": [
          "노출된 관리 포트(22/3389)·DB 포트(3306/5432 등)가 의도된 공개인지"
        ]
      }
    },
    {
      "rule_id": "R-2.10.3-04",
      "name": "공개 Ingress rate limit 미설정",
      "judgment_source": "k8s_api",
      "extraction_method": "api",
      "rate_limit_annotations": [
        "nginx.ingress.kubernetes.io/limit-rps",
        "nginx.ingress.kubernetes.io/limit-rpm",
        "nginx.ingress.kubernetes.io/limit-connections",
        "alb.ingress.kubernetes.io/actions.rate-limit"
      ],
      "compliance_indicators": [
        {
          "field": "public_ingress_has_rate_limit",
          "op": "==",
          "value": true,
          "description": "공개 Ingress에 rate limit annotation 설정됨 — DDoS/과다요청 방어"
        }
      ],
      "remediation": {
        "source": {
          "framework": "자체 정책 (표준 미대응)",
          "version": null,
          "reference": "rate limit(과다요청·DDoS 방어)",
          "url": null
        },
        "action": "공개 Ingress에 rate-limit annotation(예: nginx limit-rps)을 설정한다."
      },
      "judgment_logic": {
        "type": "structured_match",
        "aggregation": "all_compliance_required",
        "min_pass_ratio": 1.0
      }
    },
    {
      "rule_id": "R-2.10.3-05",
      "name": "LoadBalancer 공개 의도 라벨 부재",
      "judgment_source": "k8s_api",
      "extraction_method": "api",
      "compliance_indicators": [
        {
          "field": "lb_service.metadata.labels.exposure-intent",
          "op": "in",
          "value": [
            "public",
            "internal-only"
          ],
          "description": "LoadBalancer Service에 공개 의도 라벨(exposure-intent) 존재 — 외부 노출 의도 명시"
        },
        {
          "field": "lb_has_internal_annotation_or_public_label",
          "op": "==",
          "value": true,
          "description": "internal LB annotation 또는 public exposure-intent 라벨 중 하나 존재"
        }
      ],
      "remediation": {
        "source": {
          "framework": "자체 정책 (표준 미대응)",
          "version": null,
          "reference": "노출 의도 라벨(exposure-intent)",
          "url": null
        },
        "action": "LoadBalancer Service에 exposure-intent 라벨 또는 internal LB annotation을 부여해 노출 의도를 명시한다."
      },
      "judgment_logic": {
        "type": "structured_match",
        "aggregation": "all_compliance_required",
        "min_pass_ratio": 1.0
      }
    },
    {
      "rule_id": "R-2.10.3-SG01",
      "name": "Security Group 민감·관리 포트 외부 노출 (공개서버 강화)",
      "judgment_source": "aws_api",
      "extraction_method": "manual",
      "verdict_type": "potential_finding",
      "manual_meta": {
        "target_resource": "AWS::EC2::SecurityGroup",
        "required_data": [
          "aws_security_groups.ingress_rules"
        ],
        "condition": {
          "operator": "sg_sensitive_port_world_open",
          "forbidden_cidrs": [
            "0.0.0.0/0",
            "::/0"
          ],
          "sensitive_ports": [
            22,
            3389,
            3306,
            5432,
            6379,
            27017,
            9200,
            11211,
            6443
          ],
          "flag_all_ports": true
        },
        "compliance_mappings": [
          {
            "framework": "ISMS-P",
            "item": "2.10.3",
            "match_strength": "direct"
          }
        ],
        "kisa_defect_case_refs": [
          {
            "case_number": null,
            "description": "공개서버의 관리·DB 포트가 인터넷에 직접 노출",
            "match": "direct"
          }
        ],
        "automation_coverage": {
          "percentage": 90,
          "covered": "SG ingress 0.0.0.0/0 + 민감/관리 포트 자동 탐지",
          "not_covered": "공개 의도 여부, 상위 WAF/NACL 보완 통제"
        },
        "offcluster_satisfaction_conditions": [
          "노출된 관리 포트(22/3389)·DB 포트(3306/5432 등)가 의도된 공개인지"
        ],
        "k8s_only_check": false,
        "deferred": false
      },
      "promoted_from": "SG-2.10.3-01",
      "manual_check_output": {
        "applies_when": "fail",
        "absorbed_from": "SG-2.10.3-01",
        "compliance_mappings": [
          {
            "framework": "ISMS-P",
            "item": "2.10.3",
            "match_strength": "direct"
          }
        ],
        "offcluster_satisfaction_conditions": [
          "노출된 관리 포트(22/3389)·DB 포트(3306/5432 등)가 의도된 공개인지"
        ]
      },
      "remediation": {
        "source": {
          "framework": "CIS AWS Foundations Benchmark",
          "version": "v5.0.0",
          "reference": "§5 Networking — 보안그룹 포트 노출 제한",
          "url": "https://www.cisecurity.org/benchmark/amazon_web_services"
        },
        "action": "공개서버 Security Group에서 민감·관리 포트의 외부 노출을 제거하고 필요한 서비스 포트만 허용한다."
      }
    },
    {
      "rule_id": "R-2.10.3-GL01",
      "name": "공개서버 분리·강화 보호대책",
      "judgment_source": "text_extraction",
      "extraction_method": "rag",
      "keywords": [
        "외부에 공개되는 서버는 내부 네트워크와 분리하고, 취약점 점검·접근통제·이상징후 모니터링 등 강화된 보호대책을 수립·이행한다."
      ],
      "compliance_indicators": [
        {
          "description": "공개서버를 내부망과 분리하고 강화된 보호대책을 수립·이행하도록 규정"
        }
      ],
      "remediation": {
        "source": {
          "framework": "ISMS-P 인증기준 안내서(KISA)",
          "version": "2023.11",
          "reference": "ISMS-P 2.10.3 인증기준 / 안내서 주요 확인사항",
          "url": "https://isms.kisa.or.kr"
        },
        "action": "내부 정책·지침서에 다음을 명문화하고 책임자 승인 후 시행한다: \"외부에 공개되는 서버는 내부 네트워크와 분리하고, 취약점 점검·접근통제·이상징후 모니터링 등 강화된 보호대책을 수립·이행한다.\""
      },
      "source_reference": {
        "framework": "ISMS-P",
