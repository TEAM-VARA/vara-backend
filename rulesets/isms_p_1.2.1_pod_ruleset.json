  "rules": [
    {
      "rule_id": "R-1.2.1-POD-01",
      "name": "namespace 자산 분류 라벨",
      "judgment_source": "k8s_native",
      "check_category": "pod_graph",
      "evidence_type": "namespace 라벨 점검",
      "system": "AWS EKS",
      "evidence_format": "json",
      "extraction_method": "k8s_api",
      "auto_collectable": true,
      "data_sources": [
        {
          "resource_type": "namespace",
          "api_endpoint": "GET /api/v1/namespaces/{name}",
          "fields": [".metadata.labels"],
          "python_client": "v1.read_namespace(name)"
        }
      ],
      "compliance_indicators": [
        { "field": "namespace.metadata.labels.data-classification", "op": "in", "value": ["public", "internal", "confidential", "pii", "sensitive-pii"], "description": "데이터 분류 등급 라벨 존재" },
        { "field": "namespace.metadata.labels.isms-p/owner", "op": "!=", "value": null, "description": "자산 책임자 라벨 존재" },
        { "field": "namespace.metadata.labels.isms-p/criticality", "op": "in", "value": ["critical", "high", "medium", "low"], "description": "자산 중요도 라벨 존재" }
      ],
      "deficiency_indicators": [
        { "field": "namespace.metadata.labels.data-classification", "op": "==", "value": null, "description": "data-classification 라벨 누락 — 보안등급 미부여" }
      ],
      "activates_on_pass": [
        { "condition": "data-classification == pii", "require": ["R-2.7.1-POD-01", "R-2.9.4-POD"], "note": "PII 등급 시 etcd 암호화 + 1년 이상 접속기록 필수" },
        { "condition": "data-classification == sensitive-pii", "require": ["R-2.9.4-POD"], "note": "민감 PII 시 2년 이상 접속기록 필수" }
      ],
      "judgement_logic": {
        "type": "structured_match",
        "aggregation": "all_compliance_required",
        "min_pass_ratio": 1.0
      },
      "report": ["누락된 라벨 항목", "현재 라벨 값"]
    },
    {
      "rule_id": "R-1.2.1-POD-02",
      "name": "자산 분류 기준서 정책 문서 점검",
      "judgment_source": "k8s_native",
      "check_category": "pod_graph",
      "evidence_type": "분류 정책 ConfigMap 존재·최신성 점검",
      "system": "AWS EKS",
      "evidence_format": "json",
      "extraction_method": "k8s_api",
      "auto_collectable": true,
      "data_sources": [
        {
          "resource_type": "configmap",
          "api_endpoint": "GET /api/v1/namespaces/isms-p-policies/configmaps/asset-classification-policy",
          "fields": [
            ".data.classification-criteria",
            ".data.criticality-criteria",
            ".metadata.annotations.policy-version",
            ".metadata.annotations.approved-by",
            ".metadata.annotations.approved-at"
          ],
          "python_client": "v1.read_namespaced_config_map('asset-classification-policy', 'isms-p-policies')"
        }
      ],
      "required_data_keys": ["classification-criteria", "criticality-criteria"],
      "required_annotations": ["policy-version", "approved-by", "approved-at"],
      "max_age_days": 365,
      "compliance_indicators": [
        { "field": "policy_configmap_exists", "op": "==", "value": true, "description": "분류 정책 ConfigMap 존재" },
        { "field": "has_all_required_keys", "op": "==", "value": true, "description": "분류 기준 + 중요도 기준 모두 정의됨" },
        { "field": "has_all_required_annotations", "op": "==", "value": true, "description": "버전·승인자·승인일자 메타데이터 모두 존재" },
        { "field": "policy_age_days", "op": "<=", "value": 365, "description": "정책 1년 이내 갱신" }
      ],
      "deficiency_indicators": [
        { "field": "policy_configmap_exists", "op": "==", "value": false, "description": "분류 정책 ConfigMap 부재 — namespace 라벨 값의 정의 기준 없음" },
        { "field": "has_all_required_keys", "op": "==", "value": false, "description": "분류·중요도 기준 일부 누락" },
        { "field": "policy_age_days", "op": ">", "value": 365, "description": "1년 초과 미갱신 — 최신성 요건 위반" }
      ],
      "judgement_logic": {
        "type": "structured_match",
        "aggregation": "all_compliance_required",
        "min_pass_ratio": 1.0
      },
      "report": ["정책 ConfigMap 존재 여부", "정의된 key 목록", "정책 버전·승인자·승인일자", "정책 경과일"]
    }
