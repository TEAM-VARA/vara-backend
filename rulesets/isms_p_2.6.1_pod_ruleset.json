      ],
      "deficiency_indicators": [
        {
          "field": "has_policy_capable_cni",
          "op": "==",
          "value": false,
          "description": "NetworkPolicy 지원하지 않는 CNI — 정책 선언해도 무시됨"
        },
        {
          "field": "policy_enforcement_enabled",
          "op": "==",
          "value": false,
          "description": "aws-node DaemonSet에 ENABLE_NETWORK_POLICY 미설정 또는 false — 정책 우회 가능"
        }
      ],
      "judgement_logic": {
        "type": "structured_match",
        "aggregation": "all_compliance_required",
        "min_pass_ratio": 1.0
      },
      "report": [
        "탐지된 CNI DaemonSet명",
        "ENABLE_NETWORK_POLICY 값",
        "CNI 컨테이너 이미지·버전"
      ]
    },
    {
      "rule_id": "R-2.6.1-POD-04",
