        { "field": "has_default_deny", "op": "==", "value": false, "description": "default-deny NetworkPolicy 미존재 — 모든 Pod 간 무제한 통신 가능" },
        { "field": "has_matching_policy", "op": "==", "value": false, "description": "Pod에 매칭되는 NetworkPolicy 없음 — 트래픽 통제 불가" }
      ],
      "judgement_logic": {
        "type": "structured_match",
