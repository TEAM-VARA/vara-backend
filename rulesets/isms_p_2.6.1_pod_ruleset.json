      "law": "개인정보의 안전성 확보조치 기준",
      "article": "제6조",
      "summary": "접근통제"
    }
  ],
  "rules": [
    {
      "rule_id": "R-2.6.1-POD-01",
      "name": "hostNetwork 사용 점검",
      "judgment_source": "k8s_native",
      "check_category": "pod_graph",
      "evidence_type": "Pod 호스트 네트워크 공유 점검",
      "system": "AWS EKS",
      "evidence_format": "json",
      "extraction_method": "k8s_api",
      "auto_collectable": true,
      "data_sources": [
        {
          "resource_type": "pod",
          "api_endpoint": "GET /api/v1/namespaces/{ns}/pods/{name}",
          "fields": [
            ".spec.hostNetwork",
            ".spec.hostPID",
            ".spec.hostIPC"
          ],
          "python_client": "v1.read_namespaced_pod(name, ns)"
        }
      ],
      "compliance_indicators": [
        {
          "field": "pod.spec.hostNetwork",
          "op": "!=",
          "value": true,
          "description": "hostNetwork 비활성"
        },
        {
          "field": "pod.spec.hostPID",
          "op": "!=",
          "value": true,
          "description": "hostPID 비활성"
        },
        {
          "field": "pod.spec.hostIPC",
          "op": "!=",
          "value": true,
          "description": "hostIPC 비활성"
        }
      ],
      "deficiency_indicators": [
        {
          "field": "pod.spec.hostNetwork",
          "op": "==",
          "value": true,
          "description": "hostNetwork=true — 노드 네트워크 스택 직접 공유, 네트워크 격리 무력화"
        },
        {
          "field": "pod.spec.hostPID",
          "op": "==",
          "value": true,
          "description": "hostPID=true — 노드 프로세스 네임스페이스 공유"
        },
        {
          "field": "pod.spec.hostIPC",
          "op": "==",
          "value": true,
          "description": "hostIPC=true — 노드 IPC 네임스페이스 공유"
        }
      ],
      "exception_check": {
        "annotation": "security-exception/justification",
        "system_namespaces": [
          "kube-system",
          "kube-node-lease",
          "amazon-cloudwatch"
        ]
      },
      "judgement_logic": {
        "type": "structured_match",
        "aggregation": "all_compliance_required",
        "min_pass_ratio": 1.0
      },
      "report": [
        "활성화된 호스트 공유 항목",
        "예외 사유 존재 여부"
      ]
    },
    {
      "rule_id": "R-2.6.1-POD-02",
      "name": "NetworkPolicy 적용 점검",
      "judgment_source": "k8s_native",
      "check_category": "pod_graph",
      "evidence_type": "namespace NetworkPolicy 적용 점검",
      "system": "AWS EKS",
      "evidence_format": "json",
      "extraction_method": "k8s_api",
      "auto_collectable": true,
      "data_sources": [
        {
          "resource_type": "networkpolicy",
          "api_endpoint": "GET /apis/networking.k8s.io/v1/namespaces/{ns}/networkpolicies",
          "fields": [
            ".spec.podSelector",
            ".spec.policyTypes"
          ],
          "python_client": "networking.list_namespaced_network_policy(ns)"
        }
      ],
      "compliance_indicators": [
        {
          "field": "has_default_deny",
          "op": "==",
          "value": true,
          "description": "default-deny(Ingress+Egress) NetworkPolicy 존재"
        },
        {
          "field": "has_matching_policy",
          "op": "==",
          "value": true,
          "description": "Pod에 매칭되는 허용 NetworkPolicy 존재"
        }
      ],
      "deficiency_indicators": [
        {
          "field": "has_default_deny",
          "op": "==",
          "value": false,
          "description": "default-deny NetworkPolicy 미존재 — 모든 Pod 간 무제한 통신 가능"
        },
        {
          "field": "has_matching_policy",
          "op": "==",
          "value": false,
          "description": "Pod에 매칭되는 NetworkPolicy 없음 — 트래픽 통제 불가"
        }
      ],
      "judgement_logic": {
        "type": "structured_match",
        "aggregation": "all_compliance_required",
        "min_pass_ratio": 1.0
      },
      "report": [
        "default-deny 존재 여부",
        "Pod 매칭 NetworkPolicy 목록"
      ]
    },
    {
