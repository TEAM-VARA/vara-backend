          "name": "cilium",
          "daemonset_name": "cilium",
          "policy_enforcement": "native"
        },
        {
          "name": "weave",
          "daemonset_name": "weave-net",
          "policy_enforcement": "native"
        },
        {
          "name": "aws-vpc-cni",
          "daemonset_name": "aws-node",
          "policy_enforcement": "conditional",
          "required_env": {
            "ENABLE_NETWORK_POLICY": "true"
          }
