      ],
      "judgement_logic": {
        "type": "structured_match",
        "aggregation": "all_compliance_required",
        "min_pass_ratio": 1.0
      },
      "report": [
        "Pod 매칭 egress NetworkPolicy 목록",
        "cross-namespace 통신 통제 여부"
