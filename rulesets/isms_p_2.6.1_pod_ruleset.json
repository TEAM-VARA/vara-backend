      "check_category": "pod_graph",
      "evidence_type": "CNI DaemonSet 종류 및 정책 강제 환경변수 점검",
      "system": "AWS EKS",
      "evidence_format": "json",
      "extraction_method": "k8s_api",
      "auto_collectable": true,
      "judgment_source_note": "AWS EKS describe-addon API 대신 kube-system namespace의 DaemonSet과 그 env 변수를 직접 점검하여 동등한 판단 가능",
      "data_sources": [
