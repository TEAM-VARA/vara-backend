  "item": {
    "id": "2.5.5",
    "name": "특수 계정 및 권한 관리",
    "category_path": "2. 보호대책 요구사항 > 2.5 인증 및 권한관리 > 2.5.5 특수 계정 및 권한 관리",
    "description": "정보시스템 관리, 개인정보 및 중요정보 관리 등 특수 목적을 위하여 사용하는 계정 및 권한은 최소한으로 부여하고 별도로 식별하여 통제하여야 한다."
  },
  "legal_references": [
    {
      "law": "개인정보 보호법",
      "article": "제29조",
      "summary": "안전조치의무"
    },
    {
      "law": "개인정보의 안전성 확보조치 기준",
      "article": "제5조",
      "summary": "접근 권한의 관리"
    }
  ],
  "rules": [
    {
      "rule_id": "R-2.5.5-GL01",
      "name": "특수 권한 현황을 정기적으로 검토하고 불필요한 권한을 회수하도록 규정",
      "judgment_source": "text_extraction",
      "extraction_method": "rag",
      "keywords": [
        "특수 권한 현황을 분기 이내 주기로 정기 검토하고 불필요한 권한을 회수하도록 규정한다."
      ],
      "compliance_indicators": [
        {
          "field": "검토주기",
          "op": "<=",
          "value": "분기",
          "description": "특수 권한 검토 주기를 분기 이내로 규정"
        }
      ],
      "remediation": {
        "source": {
          "framework": "ISMS-P 인증기준 안내서(KISA)",
          "version": "2023.11",
          "reference": "ISMS-P 2.5.5 인증기준 / 안내서 주요 확인사항",
          "url": "https://isms.kisa.or.kr"
        },
        "action": "내부 정책·지침서에 다음을 명문화하고 책임자 승인 후 시행한다: \"특수 권한 현황을 분기 이내 주기로 정기 검토하고 불필요한 권한을 회수하도록 규정한다.\""
      },
      "judgment_logic": {
        "type": "semantic_match",
        "method": "llm_rag_entailment"
      }
    },
    {
