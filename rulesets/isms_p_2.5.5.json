        }
      ],
      "remediation": {
        "source": {
          "framework": "CIS Amazon EKS Benchmark",
          "version": "v1.7.0+",
          "reference": "§4.1.4 RBAC — Minimize access to create pods",
          "url": "https://www.cisecurity.org/benchmark/kubernetes"
        },
        "action": "pods/워크로드 직접 create 권한을 최소화하고 배포는 컨트롤러·파이프라인 경유로 제한한다."
      },
      "exception_check": {
        "annotation": "rbac-exception/justification",
        "system_namespaces": [
          "kube-system",
          "kube-node-lease"
        ]
      },
      "judgment_logic": {
        "type": "structured_match",
        "aggregation": "all_compliance_required"
      },
      "source_reference": {
        "framework": "CIS Amazon EKS Benchmark",
        "control": "4.1.4",
        "basis": "Minimize access to create pods — 워크로드 생성 권한 최소화 (2.6.3→2.5.5 이관)"
      },
      "manual_check_output": {
        "applies_when": "fail"
      }
    }
  ],
  "evaluation_strategy": {
    "overall_verdict_logic": "all_rules_pass_required",
    "description": "text_extraction 6개 + k8s_api 3개(R-2.5.5-01·02·08) + aws_api 1개(R-2.5.5-07) 모두 PASS여야 항목 충족"
