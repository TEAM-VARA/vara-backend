      "remediation": {
        "source": {
          "framework": "ISMS-P 인증기준 안내서(KISA)",
          "version": "2023.11",
          "reference": "ISMS-P 2.5.5 인증기준 / 안내서 주요 확인사항",
          "url": "https://isms.kisa.or.kr"
        },
        "action": "내부 정책·지침서에 다음을 명문화하고 책임자 승인 후 시행한다: \"불필요한 특수 권한을 발견 즉시 회수하도록 규정한다.\""
      },
      "judgment_logic": {
        "type": "semantic_match",
        "method": "llm_rag_entailment"
      }
    },
