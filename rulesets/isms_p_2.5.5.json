    {
      "rule_id": "R-2.5.5-01",
      "name": "ServiceAccount 특수 권한 점검",
      "judgment_source": "k8s_api",
      "extraction_method": "api",
      "compliance_indicators": [
        {
          "field": "has_cluster_admin",
          "op": "==",
          "value": false,
          "description": "cluster-admin 바인딩 없음"
        },
        {
          "field": "has_wildcard_permission",
          "op": "==",
          "value": false,
          "description": "verbs:* + resources:* 와일드카드 권한 없음"
        },
        {
          "field": "has_cluster_wide_secrets",
          "op": "==",
          "value": false,
          "description": "클러스터 전체 Secret 접근 권한 없음"
        }
      ],
      "remediation": {
        "source": {
          "framework": "CIS Amazon EKS Benchmark",
          "version": "v1.7.0+",
          "reference": "§4 RBAC — cluster-admin·wildcard 최소화",
          "url": "https://www.cisecurity.org/benchmark/kubernetes"
        },
        "action": "cluster-admin·와일드카드(verbs:*/resources:*)·클러스터 전역 Secret 접근 바인딩을 제거하고 최소권한 Role로 대체한다."
      },
      "judgment_logic": {
        "type": "structured_match",
        "aggregation": "all_compliance_required"
      },
      "manual_check_output": {
        "applies_when": "fail",
        "absorbed_from": "F-2.5.5-01",
        "offcluster_satisfaction_conditions": [
          "최고권한(cluster-admin 등) 부여하는 것이 승인된 바 있는지, 별도 식별·감사 대상으로 관리되는지"
        ]
      }
    },
    {
      "rule_id": "R-2.5.5-02",
      "name": "위험 RBAC verb 조합 점검",
      "judgment_source": "k8s_api",
      "extraction_method": "api",
      "dangerous_verb_combinations": [
        {
          "name": "pod_exec_attach",
          "verbs": [
            "create",
            "get"
          ],
          "resources": [
            "pods/exec",
            "pods/attach",
            "pods/portforward"
          ],
          "risk": "컨테이너 내부 임의 명령 실행",
          "cis": "4.1.8"
        },
        {
          "name": "secret_read_cluster_wide",
          "verbs": [
            "get",
            "list",
            "watch"
          ],
          "resources": [
            "secrets"
          ],
          "scope": "cluster_wide",
          "risk": "클러스터 전체 비밀정보 열람"
        },
        {
          "name": "secret_write",
          "verbs": [
            "create",
            "update",
            "patch",
            "delete"
          ],
          "resources": [
            "secrets"
          ],
          "risk": "비밀정보 변조·삭제"
        },
        {
          "name": "rbac_escalate",
          "verbs": [
            "escalate"
          ],
          "resources": [
            "clusterroles",
            "roles"
          ],
          "risk": "RBAC 권한 자체 상승"
        },
        {
          "name": "rbac_bind",
          "verbs": [
            "bind"
          ],
          "resources": [
            "clusterroles",
            "roles"
          ],
          "risk": "임의 권한 바인딩"
        },
        {
          "name": "impersonate",
          "verbs": [
            "impersonate"
          ],
          "resources": [
            "users",
            "groups",
            "serviceaccounts"
          ],
          "risk": "다른 계정 가장하여 API 호출"
        },
        {
          "name": "node_proxy",
          "verbs": [
            "get",
            "create"
          ],
          "resources": [
            "nodes/proxy"
          ],
          "risk": "kubelet API 직접 접근",
          "cis": "4.1.10"
        },
        {
          "name": "sa_token_request",
          "verbs": [
            "create"
          ],
          "resources": [
            "serviceaccounts/token"
          ],
          "risk": "임의 ServiceAccount 토큰 발급",
          "cis": "4.1.12"
        },
        {
          "name": "pv_create",
          "verbs": [
            "create"
          ],
          "resources": [
            "persistentvolumes"
          ],
          "risk": "PV로 hostPath 마운트 → 노드 파일시스템 접근·탈출",
          "cis": "4.1.9"
        },
        {
          "name": "webhook_config",
          "verbs": [
            "create",
            "update",
            "patch"
          ],
          "resources": [
            "validatingwebhookconfigurations",
            "mutatingwebhookconfigurations"
          ],
          "risk": "admission webhook 조작 → 정책 우회·요청 가로채기",
          "cis": "4.1.11"
        }
      ],
      "compliance_indicators": [
        {
          "field": "has_dangerous_verb_combo",
          "op": "==",
          "value": false,
          "description": "위험 verb 조합 미보유"
        }
      ],
      "remediation": {
        "source": {
          "framework": "CIS Amazon EKS Benchmark",
          "version": "v1.7.0+",
          "reference": "§4.1 RBAC — 위험 verb 최소화 (4.1.8 pods/exec·4.1.9 pv·4.1.10 nodes/proxy·4.1.11 webhook·4.1.12 sa/token)",
          "url": "https://www.cisecurity.org/benchmark/kubernetes"
        },
        "action": "위험 verb 조합(bind/escalate/impersonate, create pods+secrets get 등)을 가진 Role을 분리·축소한다."
      },
      "exception_check": {
        "annotation": "rbac-exception/justification",
        "system_namespaces": [
          "kube-system",
          "kube-node-lease"
        ]
      },
      "judgment_logic": {
        "type": "structured_match",
        "aggregation": "all_compliance_required"
      },
      "manual_check_output": {
        "applies_when": "fail",
        "absorbed_from": "F-2.5.5-02",
        "offcluster_satisfaction_conditions": [
          "최고권한(cluster-admin 등) 부여하는 것이 승인된 바 있는지, 별도 식별·감사 대상으로 관리되는지"
        ]
      }
    },
    {
      "rule_id": "R-2.5.5-07",
      "name": "EKS 접근 표준화(access entries/API) 점검",
      "judgment_source": "k8s_api",
      "extraction_method": "api",
      "compliance_indicators": [
        {
          "field": "authentication_mode",
          "op": "==",
          "value": "API",
          "description": "EKS 접근을 access entries(API)로 표준화 (aws-auth ConfigMap 미의존)"
        }
      ],
      "remediation": {
        "source": {
          "framework": "CIS Amazon EKS Benchmark",
          "version": "v2.0.0",
          "reference": "§4.1.7 access entries / §5.5.1 — IAM 접근 표준화",
          "url": "https://www.cisecurity.org/benchmark/kubernetes"
        },
        "action": "EKS authentication_mode를 API로 전환하고 IAM principal 접근을 access entries로 관리한다. 구식 aws-auth ConfigMap 의존을 제거한다. (API_AND_CONFIG_MAP은 전환 중 상태로 잔존 ConfigMap 정리 필요)"
      },
      "judgment_logic": {
        "type": "structured_match",
        "method": "eks_authentication_mode"
      },
      "manual_check_output": {
        "applies_when": "fail",
        "additional_review_items": [
          "authentication_mode를 API 전용으로 전환할 계획·일정",
          "kube-system/aws-auth ConfigMap 잔존 시 정리 계획",
          "access entries로 IAM principal 매핑 이전 완료 여부"
        ],
        "alternative_controls": [
          "access entries(API) 기반 IAM 접근 표준화",
          "aws-auth ConfigMap 제거 후 API 전용 운영"
        ],
        "compliance_mappings": [
          {
            "framework": "ISMS-P",
            "item": "2.5.5",
            "match_strength": "direct"
          }
        ]
      }
    },
    {
      "rule_id": "R-2.5.5-08",
      "name": "워크로드 생성 권한 최소화 (pods/워크로드 create)",
      "judgment_source": "k8s_api",
      "extraction_method": "api",
      "dangerous_verb_combinations": [
        {
          "name": "workload_create",
          "verbs": [
            "create"
          ],
          "resources": [
            "pods",
            "deployments",
            "daemonsets",
