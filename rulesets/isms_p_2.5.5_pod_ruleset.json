          "resource_type": "pod",
          "api_endpoint": "GET /api/v1/namespaces/{ns}/pods/{name}",
          "fields": [
            ".spec.serviceAccountName"
          ],
          "python_client": "v1.read_namespaced_pod(name, ns)"
        },
        {
          "resource_type": "clusterrolebinding",
          "api_endpoint": "GET /apis/rbac.authorization.k8s.io/v1/clusterrolebindings",
          "fields": [
            ".subjects",
            ".roleRef"
          ],
          "python_client": "rbac.list_cluster_role_binding()"
        },
        {
          "resource_type": "rolebinding",
          "api_endpoint": "GET /apis/rbac.authorization.k8s.io/v1/namespaces/{ns}/rolebindings",
          "fields": [
            ".subjects",
            ".roleRef"
          ],
          "python_client": "rbac.list_namespaced_role_binding(ns)"
        },
        {
          "resource_type": "clusterrole",
          "api_endpoint": "GET /apis/rbac.authorization.k8s.io/v1/clusterroles/{name}",
          "fields": [
            ".rules"
          ],
          "python_client": "rbac.read_cluster_role(name)"
        }
      ],
      "compliance_indicators": [
