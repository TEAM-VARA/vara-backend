    {
      "rule_id": "R-2.6.1-SG01",
      "name": "Security Group 인바운드 전체 개방 (영역 분리·비인가 접근)",
      "judgment_source": "aws_api",
      "extraction_method": "api",
      "verdict_type": "potential_finding",
      "risk_scope": "account",
      "fanout": "nodes_pods",
      "manual_meta": {
        "target_resource": "AWS::EC2::SecurityGroup",
        "required_data": [
          "aws_security_groups.ingress_rules"
        ],
        "condition": {
          "operator": "sg_world_open_ingress",
          "forbidden_cidrs": [
            "0.0.0.0/0",
            "::/0"
          ],
          "allowed_public_ports": [
            80,
            443
          ]
        },
        "compliance_mappings": [
          {
            "framework": "ISMS-P",
            "item": "2.6.1",
            "match_strength": "direct"
          }
        ],
        "kisa_defect_case_refs": [
          {
            "case_number": null,
            "description": "서버팜/사무망 미분리 — 광범위 인바운드 허용",
            "match": "direct"
          }
        ],
        "automation_coverage": {
          "percentage": 85,
          "covered": "SG ingress 0.0.0.0/0 자동 탐지",
          "not_covered": "영역 분리 설계 의도, 사내망 IP 정책"
        },
        "offcluster_satisfaction_conditions": [
          "0.0.0.0/0 인바운드가 의도된 공개 서비스(80/443)인지 확인하세요.",
          "허용 출발지를 특정 SG/CIDR로 제한했는지"
        ],
        "k8s_only_check": false,
        "deferred": false
      },
      "promoted_from": "SG-2.6.1-01",
      "manual_check_output": {
        "applies_when": "fail",
        "absorbed_from": "SG-2.6.1-01",
        "compliance_mappings": [
          {
            "framework": "ISMS-P",
            "item": "2.6.1",
            "match_strength": "direct"
          }
        ],
        "offcluster_satisfaction_conditions": [
          "0.0.0.0/0 인바운드가 의도된 공개 서비스(80/443)인지 확인하세요.",
          "허용 출발지를 특정 SG/CIDR로 제한했는지"
        ]
      },
      "remediation": {
        "source": {
          "framework": "CIS AWS Foundations Benchmark",
          "version": "v5.0.0",
          "reference": "§5 Networking — 인바운드 0.0.0.0/0 제한",
          "url": "https://www.cisecurity.org/benchmark/amazon_web_services"
        },
        "action": "Security Group 인바운드의 0.0.0.0/0 전체 개방을 제거하고 필요한 포트·대역만 허용한다."
