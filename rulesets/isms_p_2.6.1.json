{
  "schema_version": "4.0.0",
  "isms_p_revision": "2023.11",
  "item": {
    "id": "2.6.1",
    "name": "네트워크 접근",
    "category_path": "2. 보호대책 요구사항 > 2.6 접근통제 > 2.6.1 네트워크 접근",
    "description": "네트워크에 대한 비인가 접근을 통제하기 위하여 IP 관리, 단말 인증 등 관리절차를 수립·이행하고, 업무 목적 및 중요도에 따라 네트워크 분리(DMZ, 서버팜, DB존, 개발존 등)와 접근통제를 적용하여야 한다."
  },
  "legal_references": [
    {
      "law": "개인정보 보호법",
      "article": "제29조",
      "summary": "안전조치의무"
    },
    {
      "law": "개인정보의 안전성 확보조치 기준",
      "article": "제6조",
      "summary": "접근통제"
    }
  ],
  "rules": [
    {
      "rule_id": "R-2.6.1-01",
      "name": "hostNetwork 사용 점검",
      "judgment_source": "k8s_api",
      "extraction_method": "api",
      "compliance_indicators": [
        {
          "field": "pod.spec.hostNetwork",
          "op": "!=",
          "value": true,
          "description": "hostNetwork 비활성"
        },
        {
          "field": "pod.spec.hostPID",
          "op": "!=",
          "value": true,
          "description": "hostPID 비활성"
        },
        {
          "field": "pod.spec.hostIPC",
          "op": "!=",
          "value": true,
          "description": "hostIPC 비활성"
        }
      ],
      "remediation": {
        "source": {
          "framework": "Kubernetes Pod Security Standards",
          "version": null,
          "reference": "Baseline: Host Namespaces — CIS EKS §5 대응",
          "url": "https://kubernetes.io/docs/concepts/security/pod-security-standards/"
        },
        "action": "Pod spec의 hostNetwork·hostPID·hostIPC를 false(미설정)로 두고, 불가피하면 사유 annotation으로 예외 관리한다."
      },
      "exception_check": {
        "annotation": "security-exception/justification",
        "system_namespaces": [
          "kube-system",
          "kube-node-lease",
          "amazon-cloudwatch"
        ]
      },
      "judgment_logic": {
        "type": "structured_match",
        "aggregation": "all_compliance_required",
        "min_pass_ratio": 1.0
      }
    },
    {
      "rule_id": "R-2.6.1-02",
      "name": "NetworkPolicy 적용 점검",
      "judgment_source": "k8s_api",
      "extraction_method": "api",
      "compliance_indicators": [
        {
          "field": "has_default_deny",
          "op": "==",
          "value": true,
          "description": "default-deny(Ingress+Egress) NetworkPolicy 존재"
        },
        {
          "field": "has_matching_policy",
          "op": "==",
          "value": true,
          "description": "Pod에 매칭되는 허용 NetworkPolicy 존재"
        }
      ],
      "remediation": {
        "source": {
          "framework": "CIS Amazon EKS Benchmark",
          "version": "v1.7.0+",
          "reference": "§5 Policies — NetworkPolicy default-deny (Kyverno)",
          "url": "https://www.cisecurity.org/benchmark/kubernetes"
        },
        "action": "네임스페이스에 default-deny(Ingress+Egress) NetworkPolicy를 두고 워크로드별 허용 정책을 추가한다."
      },
      "judgment_logic": {
        "type": "structured_match",
        "aggregation": "all_compliance_required",
        "min_pass_ratio": 1.0
      },
      "verdict_policy": {
        "pass": "충족",
        "fail": "미충족",
        "alternative_control_satisfies": true,
        "no_uncertain_fallback": true,
        "_decision": "default-deny NetworkPolicy 미탐지 AND 대체통제(alternative_controls: VPC SG·Mesh 등) 미탐지 시 확인불가 없이 미충족 확정. 대체통제 탐지 시 충족."
      },
      "manual_check_output": {
        "applies_when": "always",
        "absorbed_from": "F-2.6.1-01",
        "alternative_controls": [
          "VPC subnet 분리 + Security Group",
          "Istio AuthorizationPolicy",
          "Calico GlobalNetworkPolicy",
          "별도 클러스터 운영"
        ],
        "kisa_defect_case_refs": [
          {
            "case_number": null,
            "description": "서버팜과 사무망 미분리",
            "match": "partial"
          }
        ],
        "compliance_mappings": [
          {
            "framework": "ISMS-P",
            "item": "2.6.1",
            "match_strength": "indirect"
          }
        ],
        "offcluster_satisfaction_conditions": [
          "K8s NetworkPolicy 외 네트워크 분리 통제가 적용되어 있는지 확인하세요"
        ]
      }
    },
    {
      "rule_id": "R-2.6.1-03",
      "name": "CNI NetworkPolicy 강제 지원 점검",
      "judgment_source": "k8s_api",
      "extraction_method": "api",
      "risk_scope": "cluster",
      "fanout": "all_pods_in_cluster",
      "supported_cni_indicators": [
        {
          "name": "calico",
          "daemonset_name": "calico-node",
          "policy_enforcement": "native"
        },
        {
          "name": "cilium",
          "daemonset_name": "cilium",
          "policy_enforcement": "native"
        },
        {
          "name": "weave",
          "daemonset_name": "weave-net",
          "policy_enforcement": "native"
        },
        {
          "name": "aws-vpc-cni",
          "daemonset_name": "aws-node",
          "policy_enforcement": "conditional",
          "required_env": {
            "ENABLE_NETWORK_POLICY": "true"
          }
        }
      ],
      "compliance_indicators": [
        {
          "field": "has_policy_capable_cni",
          "op": "==",
          "value": true,
          "description": "NetworkPolicy 강제 가능한 CNI DaemonSet 존재"
        },
        {
          "field": "policy_enforcement_enabled",
          "op": "==",
          "value": true,
          "description": "aws-vpc-cni 경우 aws-node DaemonSet env에 ENABLE_NETWORK_POLICY=true 설정"
        }
      ],
      "remediation": {
        "source": {
          "framework": "CIS Amazon EKS Benchmark",
          "version": "v1.7.0+",
          "reference": "§5 Policies — policy-capable CNI",
          "url": "https://www.cisecurity.org/benchmark/kubernetes"
        },
        "action": "NetworkPolicy 강제 가능한 CNI를 사용한다(aws-vpc-cni면 ENABLE_NETWORK_POLICY=true, 또는 Calico/Cilium)."
      },
      "judgment_logic": {
        "type": "structured_match",
        "aggregation": "all_compliance_required",
        "min_pass_ratio": 1.0
      },
      "verdict_policy": {
        "pass": "충족",
        "fail": "미충족",
        "alternative_control_satisfies": true,
        "no_uncertain_fallback": true,
        "_decision": "정책 강제 가능 CNI 미탐지 AND 대체통제 미탐지 시 미충족 확정."
      },
      "manual_check_output": {
        "applies_when": "always",
        "absorbed_from": "F-2.6.1-02",
        "alternative_controls": [
          "AWS VPC CNI + Security Group",
          "Service Mesh",
          "외부 NetFW"
        ],
        "compliance_mappings": [
          {
            "framework": "ISMS-P",
            "item": "2.6.1",
            "match_strength": "indirect"
          }
        ],
        "offcluster_satisfaction_conditions": [
          "K8s NetworkPolicy 외 네트워크 분리 통제가 적용되어 있는지 확인하세요"
        ]
      }
    },
    {
      "rule_id": "R-2.6.1-04",
      "name": "cross-namespace 통신 통제 부재",
