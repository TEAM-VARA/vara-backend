        "_decision": "cross-namespace egress 통제 미탐지 AND 대체통제 미탐지 시 미충족 확정."
      },
      "manual_check_output": {
        "applies_when": "always",
        "absorbed_from": "F-2.6.1-03",
        "alternative_controls": [
          "VPC 라우팅",
          "Service Mesh",
