  "rules": [
    {
      "rule_id": "R-2.7.1-POD-01",
      "name": "Secret etcd 암호화 점검",
      "judgment_source": "manual_evidence",
      "check_category": "manual_evidence",
      "evidence_type": "EKS Secret 암호화 설정 증적",
      "system": "AWS EKS",
      "evidence_format": "image_or_text",
      "extraction_method": "vlm_or_structured_parse",
      "auto_collectable": false,
      "judgment_source_note": "AWS API(eks.describe_cluster) 접근이 보장되지 않는 환경을 위해 회사가 직접 증적 업로드. 단, Pod의 Secret 참조 목록은 k8s_api로 수집하여 컨텍스트로만 제공",
      "auto_collected_context": {
        "purpose": "informational_only_not_for_judgment",
        "data_sources": [
          { "resource_type": "pod", "api_endpoint": "GET /api/v1/namespaces/{ns}/pods/{name}", "fields": [".spec.volumes[].secret.secretName", ".spec.containers[].envFrom[].secretRef.name", ".spec.containers[].env[].valueFrom.secretKeyRef.name"], "python_client": "v1.read_namespaced_pod(name, ns)" }
        ]
      },
      "manual_evidence_spec": {
        "title": "EKS 클러스터 Secret 암호화 설정 캡처",
        "description": "etcd에 저장되는 Kubernetes Secret이 KMS로 envelope 암호화되어 있음을 증명",
        "acceptable_formats": ["png", "jpg", "pdf", "json", "txt"],
        "max_age_days": 365,
        "recommended_evidence_sources": [
          "AWS Console → EKS → 대상 클러스터 → Overview 탭 → 'Secrets encryption' 섹션 캡처",
          "CLI 출력 캡처/파일: `aws eks describe-cluster --name <CLUSTER명> --query 'cluster.encryptionConfig'`"
        ],
        "required_content": [
          { "field": "encryption_resources", "description": "암호화 대상에 'secrets' 포함 여부", "expected_pattern": "['secrets']" },
          { "field": "kms_key_arn", "description": "사용 중인 KMS 키 ARN", "expected_pattern": "^arn:aws:kms:[a-z0-9-]+:[0-9]{12}:key/[a-f0-9-]+$" },
          { "field": "cluster_name", "description": "EKS 클러스터명 (룰 평가 대상 클러스터와 일치 확인)" }
        ],
        "vlm_extraction_prompt": "이 캡처에서 EKS 클러스터의 Secret 암호화 설정 정보를 추출하라. 추출할 항목: (1) 암호화 대상 리소스 목록 (resources 또는 'Encrypted resources'에 'secrets'가 있는지), (2) KMS 키 ARN, (3) 클러스터 이름. JSON으로 응답."
      },
      "compliance_indicators": [
        { "field": "evidence.encryption_resources", "op": "contains", "value": "secrets", "description": "secrets 리소스가 암호화 대상에 포함" },
        { "field": "evidence.kms_key_arn", "op": "matches_regex", "value": "^arn:aws:kms:", "description": "유효한 KMS 키 ARN 존재" }
      ],
      "deficiency_indicators": [
        { "field": "evidence.encryption_resources", "op": "==", "value": null, "description": "encryptionConfig 미설정 — Secret이 base64 인코딩으로만 저장" },
        { "field": "evidence.encryption_resources", "op": "not_contains", "value": "secrets", "description": "secrets가 암호화 대상에 미포함" }
      ],
      "judgement_logic": {
        "type": "manual_evidence_match",
        "method": "vlm_extract_then_structured_match",
        "aggregation": "all_compliance_required",
        "min_pass_ratio": 1.0
      },
      "report": ["업로드 증적 파일명", "추출된 encryptionConfig 내용", "Pod가 참조하는 Secret 목록(컨텍스트)", "캡처 일자"]
    },
    {
      "rule_id": "R-2.7.1-POD-02",
      "name": "ConfigMap 평문 비밀값 점검",
      "judgment_source": "k8s_native",
      "check_category": "pod_graph",
      "evidence_type": "ConfigMap 민감정보 평문 저장 점검",
      "system": "AWS EKS",
      "evidence_format": "json",
      "extraction_method": "k8s_api",
      "auto_collectable": true,
      "data_sources": [
        { "resource_type": "pod", "api_endpoint": "GET /api/v1/namespaces/{ns}/pods/{name}", "fields": [".spec.volumes[].configMap.name", ".spec.containers[].envFrom[].configMapRef.name"], "python_client": "v1.read_namespaced_pod(name, ns)" },
        { "resource_type": "configmap", "api_endpoint": "GET /api/v1/namespaces/{ns}/configmaps/{name}", "fields": [".data"], "python_client": "v1.read_namespaced_config_map(name, ns)" }
      ],
      "secret_patterns": [
        { "name": "password", "regex": "(?i)(password|passwd|pwd)\\s*[:=]\\s*[\"']?[\\w@!#$%^&*-]{6,}" },
        { "name": "aws_access_key", "regex": "AKIA[0-9A-Z]{16}" },
        { "name": "private_key", "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----" },
        { "name": "secret_token", "regex": "(?i)(secret|token|api[_-]?key)\\s*[:=]\\s*[\"']?[\\w\\-\\.]{16,}" },
        { "name": "jwt", "regex": "eyJ[\\w-]+\\.[\\w-]+\\.[\\w-]+" }
      ],
      "compliance_indicators": [
        { "field": "configmap_has_secrets", "op": "==", "value": false, "description": "Pod가 참조하는 ConfigMap에 평문 비밀값 없음" }
      ],
      "deficiency_indicators": [
        { "field": "configmap_has_secrets", "op": "==", "value": true, "description": "ConfigMap에 비밀번호/API키/인증서 등 민감정보가 평문 저장 — Secret 오브젝트로 이관 필요" }
      ],
      "judgement_logic": {
        "type": "structured_match",
        "aggregation": "all_compliance_required",
        "min_pass_ratio": 1.0
      },
      "report": ["ConfigMap 이름", "매칭된 키 이름 및 패턴 유형"]
    },
    {
      "rule_id": "R-2.7.1-POD-03",
      "name": "전송구간 TLS 적용 점검",
      "judgment_source": "hybrid",
      "check_category": "pod_graph",
      "evidence_type": "Ingress TLS 설정(k8s) + ALB SSL 정책(증적)",
      "system": "AWS EKS + AWS ELBv2",
      "evidence_format": "json+image",
      "extraction_method": "k8s_api+vlm",
      "auto_collectable": false,
      "judgment_source_note": "Ingress TLS 선언은 k8s_api로 자동 점검. ALB Listener의 실제 SSL 정책명은 AWS ELBv2 API 대신 회사가 Console 또는 CLI 출력 캡처를 업로드",
      "k8s_native_check": {
        "data_sources": [
          { "resource_type": "ingress", "api_endpoint": "GET /apis/networking.k8s.io/v1/namespaces/{ns}/ingresses", "fields": [".spec.tls", ".metadata.annotations"], "python_client": "networking.list_namespaced_ingress(ns)" }
        ],
        "compliance_indicators": [
          { "field": "all_external_ingresses_have_tls", "op": "==", "value": true, "source": "k8s", "description": "외부 노출 Ingress 모두 .spec.tls 설정 존재" }
        ],
        "deficiency_indicators": [
          { "field": "ingress_without_tls", "op": "==", "value": true, "source": "k8s", "description": "TLS 미설정 Ingress — HTTP 평문 전송" }
        ]
      },
      "manual_evidence_spec": {
        "title": "ALB Listener SSL 정책 캡처",
        "description": "외부 ALB의 HTTPS Listener가 TLS 1.2 이상의 승인된 SSL 정책을 사용함을 증명",
        "acceptable_formats": ["png", "jpg", "pdf", "txt", "json"],
        "max_age_days": 180,
        "recommended_evidence_sources": [
          "AWS Console → EC2 → Load Balancers → 대상 ALB 선택 → Listeners 탭 → HTTPS:443 Listener의 'Security policy' 표시 캡처",
          "CLI 출력 캡처: `aws elbv2 describe-listeners --load-balancer-arn <ARN>`",
          "외부 검증: `nmap --script ssl-enum-ciphers -p 443 <도메인>` 출력 캡처"
        ],
        "approved_alb_ssl_policies": [
          "ELBSecurityPolicy-TLS13-1-2-2021-06",
          "ELBSecurityPolicy-TLS-1-2-Ext-2018-06",
          "ELBSecurityPolicy-FS-1-2-Res-2020-10"
        ],
        "tls_min_version": "TLSv1.2",
        "required_content": [
          { "field": "alb_arn_or_name", "description": "대상 ALB의 ARN 또는 이름 (Ingress와 매칭 확인용)" },
          { "field": "listener_protocol", "description": "Listener 프로토콜", "expected_pattern": "^HTTPS$" },
          { "field": "ssl_policy", "description": "사용 중인 SSL 정책명" }
        ],
        "vlm_extraction_prompt": "이 캡처에서 ALB(Application Load Balancer)의 HTTPS Listener 정보를 추출하라. 추출할 항목: (1) ALB 이름/ARN, (2) Listener 프로토콜(HTTP/HTTPS), (3) Security policy 또는 SSL policy 값. JSON으로 응답."
      },
      "compliance_indicators": [
        { "field": "all_external_ingresses_have_tls", "op": "==", "value": true, "source": "k8s", "description": "Ingress .spec.tls 설정 존재" },
        { "field": "evidence.listener_protocol", "op": "==", "value": "HTTPS", "source": "manual", "description": "ALB Listener HTTPS 사용" },
        { "field": "evidence.ssl_policy", "op": "in_approved_list", "value": "approved_alb_ssl_policies", "source": "manual", "description": "승인된 SSL 정책(TLS 1.2+) 사용" }
      ],
      "deficiency_indicators": [
        { "field": "ingress_without_tls", "op": "==", "value": true, "source": "k8s", "description": "TLS 미설정 Ingress 존재" },
        { "field": "evidence.ssl_policy", "op": "not_in_approved_list", "value": "approved_alb_ssl_policies", "source": "manual", "description": "약한/구형 SSL 정책 사용 — TLS 1.0/1.1 허용 가능" }
      ],
      "judgement_logic": {
        "type": "hybrid_match",
        "method": "k8s_structured_match + vlm_extract_then_structured_match",
        "aggregation": "all_compliance_required",
        "min_pass_ratio": 1.0
      },
      "report": ["TLS 미적용 Ingress 목록(k8s)", "ALB SSL 정책명(증적)", "증적 파일명", "캡처 일자"]
    },
    {
      "rule_id": "R-2.7.1-POD-04",
      "name": "KMS 키 로테이션 및 상태 점검",
      "judgment_source": "manual_evidence",
      "check_category": "manual_evidence",
      "evidence_type": "EKS 암호화 KMS 키 로테이션·상태 증적",
      "system": "AWS KMS",
      "evidence_format": "image_or_text",
      "extraction_method": "vlm_or_structured_parse",
      "auto_collectable": false,
      "judgment_source_note": "AWS KMS API 접근이 보장되지 않으므로 회사가 Console 또는 CLI 출력 캡처를 업로드",
      "manual_evidence_spec": {
        "title": "KMS Customer Managed Key 로테이션·상태 캡처",
        "description": "EKS Secret 암호화에 사용하는 KMS 키의 활성 상태, 자동 로테이션 활성, 승인 알고리즘 사용을 증명",
        "acceptable_formats": ["png", "jpg", "pdf", "json", "txt"],
        "max_age_days": 90,
        "recommended_evidence_sources": [
          "AWS Console → Key Management Service → Customer managed keys → 대상 키 클릭 → 'General configuration' 및 'Key rotation' 탭 캡처",
          "CLI 출력 캡처/파일: `aws kms describe-key --key-id <KEY_ID 또는 ARN>`",
          "CLI 출력 캡처/파일: `aws kms get-key-rotation-status --key-id <KEY_ID 또는 ARN>`"
        ],
        "approved_key_specs": ["SYMMETRIC_DEFAULT", "RSA_2048", "RSA_3072", "RSA_4096"],
        "required_content": [
          { "field": "key_arn", "description": "KMS 키 ARN" },
          { "field": "key_state", "description": "키 상태 (Enabled/Disabled/PendingDeletion 등)" },
          { "field": "key_enabled", "description": "키 사용 가능 여부 (Boolean)" },
          { "field": "key_spec", "description": "키 스펙 (알고리즘)" },
          { "field": "key_rotation_enabled", "description": "자동 키 로테이션 활성 여부 (Boolean)" }
        ],
        "vlm_extraction_prompt": "이 캡처에서 AWS KMS 키의 정보를 추출하라. 추출할 항목: (1) Key ARN, (2) Key state (Enabled 또는 다른 상태), (3) Enabled 값(true/false), (4) Key spec(SYMMETRIC_DEFAULT, RSA_2048 등), (5) Key rotation enabled 또는 'Automatic key rotation' 활성 여부. JSON으로 응답."
      },
      "compliance_indicators": [
        { "field": "evidence.key_state", "op": "==", "value": "Enabled", "description": "KMS 키 활성 상태" },
        { "field": "evidence.key_enabled", "op": "==", "value": true, "description": "KMS 키 사용 가능" },
        { "field": "evidence.key_rotation_enabled", "op": "==", "value": true, "description": "자동 키 로테이션 활성 (연 1회)" },
        { "field": "evidence.key_spec", "op": "in_approved_list", "value": "approved_key_specs", "description": "KISA 안내서 기준 알고리즘 사용 (AES-256 또는 RSA-2048 이상)" }
      ],
      "deficiency_indicators": [
        { "field": "evidence.key_state", "op": "in", "value": ["PendingDeletion", "Disabled", "Unavailable"], "description": "KMS 키 비정상 상태 — 암호화/복호화 불가" },
        { "field": "evidence.key_rotation_enabled", "op": "==", "value": false, "description": "자동 로테이션 비활성 — 키 노출 시 영구 침해 위험" }
      ],
      "judgement_logic": {
        "type": "manual_evidence_match",
        "method": "vlm_extract_then_structured_match",
        "aggregation": "all_compliance_required",
        "min_pass_ratio": 1.0
      },
      "report": ["업로드 증적 파일명", "추출된 KMS 키 ARN", "키 상태·로테이션·알고리즘", "캡처 일자"]
    }
  ],
  "evaluation_strategy": {
    "overall_verdict_logic": "any_fail_is_non_compliant",
    "description": "etcd KMS 암호화 증적(manual) + ConfigMap 평문 비밀값 없음(k8s) + Ingress TLS(k8s) + ALB SSL 정책 증적(manual) + KMS 키 활성·로테이션 증적(manual) 시 PASS",
    "source_distribution": {
