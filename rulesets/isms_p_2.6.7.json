        "system_namespaces": [
          "kube-system",
          "kube-node-lease",
          "amazon-cloudwatch"
        ]
      },
      "judgment_logic": {
        "type": "structured_match",
        "aggregation": "all_compliance_required",
        "min_pass_ratio": 1.0
      }
