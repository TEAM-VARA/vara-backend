  "item": {
    "id": "2.6.7",
    "name": "인터넷 접속 통제",
    "category_path": "2. 보호대책 요구사항 > 2.6 접근통제 > 2.6.7 인터넷 접속 통제",
    "description": "업무용 단말기 등에서 인터넷에 접속할 경우 정보유출 등의 보안사고를 예방하기 위하여 인터넷 접속 통제 정책을 수립·이행하여야 한다."
  },
  "legal_references": [
    {
      "law": "개인정보 보호법",
      "article": "제29조",
      "summary": "안전조치의무"
    },
    {
      "law": "개인정보의 안전성 확보조치 기준",
      "article": "제6조",
      "summary": "접근통제"
    }
  ],
  "rules": [
    {
      "rule_id": "R-2.6.7-01",
      "name": "egress NetworkPolicy 미적용",
      "judgment_source": "k8s_api",
      "extraction_method": "api",
      "compliance_indicators": [
        {
          "field": "has_egress_policy",
          "op": "==",
          "value": true,
          "description": "Pod에 매칭되는 Egress NetworkPolicy 존재 — 아웃바운드 트래픽 통제 적용"
        },
        {
          "field": "egress_default_deny_exists",
          "op": "==",
          "value": true,
          "description": "namespace에 Egress default-deny NetworkPolicy 존재"
        }
      ],
      "remediation": {
        "source": {
          "framework": "CIS Amazon EKS Benchmark",
          "version": "v1.7.0+",
          "reference": "§5 Policies — egress NetworkPolicy / 대체통제(NAT·프록시·Cilium FQDN)",
          "url": "https://www.cisecurity.org/benchmark/kubernetes"
        },
        "action": "네임스페이스에 egress default-deny NetworkPolicy를 두고 허용 도메인/대역만 화이트리스트한다."
      },
      "exception_check": {
        "annotation": "security-exception/egress-justification",
        "system_namespaces": [
          "kube-system",
          "kube-node-lease",
          "amazon-cloudwatch"
        ]
      },
      "judgment_logic": {
        "type": "structured_match",
        "aggregation": "all_compliance_required",
        "min_pass_ratio": 1.0
      },
      "verdict_policy": {
        "pass": "충족",
        "fail": "미충족",
        "alternative_control_satisfies": true,
        "no_uncertain_fallback": true,
        "_decision": "egress default-deny NetworkPolicy 미탐지 AND 대체통제(NAT·프록시·Cilium FQDN) 미탐지 시 미충족 확정."
      },
      "manual_check_output": {
        "applies_when": "always",
        "absorbed_from": "F-2.6.7-01",
        "alternative_controls": [
          "VPC NAT Gateway 화이트리스트",
          "프록시 서버(Squid 등)",
          "Cilium FQDN policy",
          "AWS Network Firewall"
        ],
        "kisa_defect_case_refs": [
          {
            "case_number": null,
            "description": "운영 서버에서 외부 인터넷 자유 접속",
            "match": "direct"
          }
        ],
        "compliance_mappings": [
          {
            "framework": "ISMS-P",
            "item": "2.6.7",
            "match_strength": "direct"
          }
        ],
        "offcluster_satisfaction_conditions": [
          "K8s 외 VPC NAT Gateway 화이트리스트 / 프록시(Squid 등) / Cilium FQDN policy / AWS Network Firewall로 아웃바운드 통제되고 있다면 결함이 아닙니다."
        ]
      }
    },
    {
      "rule_id": "R-2.6.7-SG01",
      "name": "Security Group egress 전체 개방 (아웃바운드 인터넷 통제)",
      "judgment_source": "aws_api",
      "extraction_method": "api",
      "verdict_type": "potential_finding",
      "risk_scope": "account",
      "fanout": "nodes_pods",
      "manual_meta": {
        "target_resource": "AWS::EC2::SecurityGroup",
        "required_data": [
          "aws_security_groups.egress_rules"
        ],
        "condition": {
          "operator": "sg_unrestricted_egress",
          "forbidden_cidrs": [
            "0.0.0.0/0",
            "::/0"
          ],
          "match_all_ports_only": true
        },
        "compliance_mappings": [
          {
            "framework": "ISMS-P",
            "item": "2.6.7",
            "match_strength": "direct"
          }
        ],
        "kisa_defect_case_refs": [
          {
            "case_number": null,
            "description": "아웃바운드 전체 허용 — 인터넷 자유 접속(유출·C2 경로)",
            "match": "direct"
          }
        ],
        "automation_coverage": {
          "percentage": 80,
          "covered": "SG egress 0.0.0.0/0 전체개방 자동 탐지",
          "not_covered": "NAT GW 화이트리스트·프록시·FQDN 등 상위 아웃바운드 통제"
        },
        "offcluster_satisfaction_conditions": [
          "K8s 외 VPC NAT Gateway 화이트리스트 / 프록시(Squid 등) / Cilium FQDN policy / AWS Network Firewall로 아웃바운드 통제되고 있다면 결함이 아닙니다."
        ],
        "k8s_only_check": false,
        "deferred": false
      },
      "promoted_from": "SG-2.6.7-01",
      "manual_check_output": {
        "applies_when": "fail",
        "absorbed_from": "SG-2.6.7-01",
        "compliance_mappings": [
          {
            "framework": "ISMS-P",
            "item": "2.6.7",
            "match_strength": "direct"
          }
        ],
        "offcluster_satisfaction_conditions": [
          "K8s 외 VPC NAT Gateway 화이트리스트 / 프록시(Squid 등) / Cilium FQDN policy / AWS Network Firewall로 아웃바운드 통제되고 있다면 결함이 아닙니다."
        ]
      },
      "remediation": {
        "source": {
          "framework": "CIS AWS Foundations Benchmark",
          "version": "v5.0.0",
          "reference": "§5 Networking — egress 제한",
          "url": "https://www.cisecurity.org/benchmark/amazon_web_services"
        },
        "action": "Security Group egress 전체 개방을 제거하고 필요한 목적지만 허용한다."
      }
    },
