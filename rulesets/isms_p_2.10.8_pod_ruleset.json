    {
      "rule_id": "R-2.10.8-POD-01",
      "name": "Node kubeletVersion EOL",
      "judgment_source": "k8s_native",
      "check_category": "pod_graph",
      "evidence_type": "Node kubelet 버전 EOL 점검",
      "system": "AWS EKS",
      "evidence_format": "json",
      "extraction_method": "k8s_api",
      "auto_collectable": true,
      "data_sources": [
        {
          "resource_type": "node",
          "api_endpoint": "GET /api/v1/nodes/{name}",
